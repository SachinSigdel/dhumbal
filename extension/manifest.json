{
  "manifest_version": 3,
  "name": "Dhumbal",
  "version": "1.0.0",
  "description": "Dhumbal, the Nepali card game: lowest hand wins. Play friends online or 1 to 4 bots, quick game or race to 100.",
  "action": {
    "default_title": "Play Dhumbal",
    "default_popup": "game.html?popup",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "game.html?panel"
  }
}
