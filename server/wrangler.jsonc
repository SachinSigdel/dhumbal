{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dhumbal",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  "observability": { "enabled": true }
}
